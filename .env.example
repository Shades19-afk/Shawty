# Supabase provides this connection string in Project Settings > Database.
# Keep the password URL-encoded if it contains characters such as @, #, or /.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Redis connection string, for example: redis://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# Optional values:
# PORT=3000
# BASE_URL=http://localhost:3000
# REDIS_CACHE_TTL_SECONDS=3600
# SHORTEN_RATE_LIMIT_WINDOW_MS=60000
# SHORTEN_RATE_LIMIT_MAX=10
